{
  "ConnectionStrings": {
    "ControlPlane": "Data Source=/data/control-plane.db"
  },
  "TenantRuntime": {
    "DockerEndpoint": "unix:///var/run/docker.sock",
    "Image": "help-motivate-me:saas-local",
    "Network": "help-motivate-me-saas-proxy",
    "BaseDomain": "localhost",
    "PublicPort": 8088,
    "StartTimeoutSeconds": 90,
    "IdleTimeoutMinutes": 30,
    "IdleSweepSeconds": 60,
    "ManagedAiApiKey": "",
    "ManagedAiProvider": "OpenAI",
    "ManagedAiModel": "gpt-4.1-mini",
    "ControlPlaneVolumeName": "help-motivate-me-saas_control-plane-data",
    "BackupRootPath": "/data/backups"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}